# SQLite (local-first). File is created relative to prisma/ when migrating.
DATABASE_URL="file:./dev.db"

# Session + encrypted BYOK keys (generate a long random string for production)
AUTH_SECRET="change-me-to-a-long-random-string"

# Set to true only for local dev without login (uses shared legacy workspace data)
# AUTH_OPTIONAL=false

# Default AI when workspace has no Team/BYOK settings (OpenAI-compatible)
# Ollama on Windows: prefer 127.0.0.1 over localhost
AI_BASE_URL="http://127.0.0.1:11434/v1"
AI_API_KEY=""
AI_MODEL="llama3.2:latest"

# Optional: encrypt workspace API keys (falls back to AUTH_SECRET)
# AI_SETTINGS_SECRET=""

# Optional: protect scheduled ingest API (npm run ingest:cron)
# CRON_SECRET=""
# RADAR_BASE_URL="http://127.0.0.1:3000"
